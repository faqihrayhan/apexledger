# ApexLedger Backend — Environment Variables
# Copy this file to .env and edit the values.

# --- Database ---
APEX_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apexledger

# --- Auth ---
APEX_JWT_SECRET=CHANGE-ME-IN-PRODUCTION

# --- App Mode ---
# Options: personal | enterprise
APEX_APP_MODE=personal

# --- AI (Community Edition) ---
# Options: disabled | byok | local | turnkey
APEX_AI_MODE=disabled
# APEX_AI_OPENAI_API_KEY=sk-...
# APEX_AI_OLLAMA_BASE_URL=http://localhost:11434
# APEX_AI_OLLAMA_MODEL=llama3.1

# --- Update Checker (Opt-In) ---
APEX_UPDATE_CHECK_ENABLED=true

# --- Enterprise License ---
# APEX_LICENSE_KEY=apex-ent-...
